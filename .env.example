# Set in Vercel Dashboard > Your Project > Settings > Environment Variables.
# Never commit an actual Resend API key or expose it to browser JavaScript.
RESEND_API_KEY=re_replace_with_private_resend_api_key
# The sending address must use a domain verified in your Resend account.
RESEND_FROM_EMAIL="Windshield Doctor <quotes@your-verified-domain.ca>"
# Incoming quote recipient (already hardcoded server-side): info.Windshielddoctorautoglass@gmail.com
# No RESEND_TO_EMAIL environment variable is necessary.
